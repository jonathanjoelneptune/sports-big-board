{
  "schemaVersion": 1,
  "release": "4.7.1",
  "baseRelease": "4.7.0",
  "title": "Non-Blocking Day State + Frontend Competition Projection",
  "atomic": true,
  "requiredFiles": [
    "VERIFY.sh",
    "VERSION",
    "index.html",
    "core-model.js",
    "foundation-certification.json",
    "release-manifest.json",
    "sbb/day_state.py",
    "architecture/day-state.js",
    "architecture/competition-registry-projection.js",
    "tests/test_v470_competition_registry_day_state.py",
    "tests/test_v471_day_state_registry_resilience.py"
  ],
  "contracts": {
    "VERSION": {
      "required": [
        "4.7.1"
      ]
    },
    "index.html": {
      "required": [
        "Sports Big Board \u2014 v4.7.1",
        "core-model.js?v=4.7.1",
        "app.js?v=4.7.1",
        "architecture/day-state.js?v=4.7.1",
        "architecture/competition-registry-projection.js?v=4.7.1"
      ],
      "forbidden": [
        "?v=4.7.0"
      ]
    },
    "core-model.js": {
      "required": [
        "version:'4.7.1'",
        "SBB_FRONTEND_REGISTRY?.competitionMap?.()",
        "SBB_COMPETITION_BUILDER?.competitionMap?.()"
      ]
    },
    "foundation-certification.json": {
      "required": [
        "\"release\": \"4.7.1\"",
        "stale-while-revalidate",
        "Frontend Competition Projection",
        "SPECIAL EVENTS",
        "Dev Competition Builder"
      ]
    },
    "sbb/day_state.py": {
      "required": [
        "COLD_WARMING",
        "STALE_REFRESHING",
        "allow_build=False",
        "self.queue.remove(day)",
        "self.queue.appendleft(day)",
        "\"engineVersion\":\"4.7.1\""
      ]
    },
    "architecture/day-state.js": {
      "required": [
        "Sports Big Board v4.7.1",
        "timeoutMs=700",
        "timeoutMs:650",
        "if(payload?.pending)return null",
        "return fallback(date)"
      ]
    },
    "architecture/competition-registry-projection.js": {
      "required": [
        "Sports Big Board v4.7.1",
        "Frontend Competition Projection",
        "/api/competition-builder/catalog",
        "/api/competition-registry",
        "localStorage.setItem",
        "sbbSpecialEventsWrap",
        "SPECIAL EVENTS \u25be",
        "function ensureDevCard()",
        "setInterval(ensureDevCard,1500)"
      ]
    },
    "tests/test_v470_competition_registry_day_state.py": {
      "required": [
        "self.assertTrue(VERSION.startswith(\"4.7.\"))",
        "f\"architecture/day-state.js?v={VERSION}\""
      ]
    },
    "tests/test_v471_day_state_registry_resilience.py": {
      "required": [
        "test_day_state_http_reads_never_build_synchronously",
        "test_browser_day_state_prepaint_is_bounded_and_falls_back",
        "test_frontend_registry_merges_builder_registry_and_last_good_cache",
        "test_special_events_are_restored_from_frontend_projection",
        "test_dev_competition_builder_launcher_retries_late_settings_dom"
      ]
    },
    "VERIFY.sh": {
      "required": [
        "python3 tools/check_release_manifest.py",
        "python3 tools/check_release_version.py",
        "python3 tools/check_foundation_certification.py",
        "python3 -m unittest tests.test_v470_competition_registry_day_state",
        "python3 -m unittest tests.test_v471_day_state_registry_resilience"
      ]
    }
  },
  "verification": [
    "python3 tools/check_release_manifest.py",
    "python3 tools/check_release_version.py",
    "python3 tools/check_foundation_certification.py",
    "python3 tools/check_ultimate_playback.py",
    "python3 tools/check_deploy_rehearsal.py",
    "python3 -m unittest tests.test_v470_competition_registry_day_state",
    "python3 -m unittest tests.test_v471_day_state_registry_resilience",
    "bash VERIFY.sh"
  ]
}
