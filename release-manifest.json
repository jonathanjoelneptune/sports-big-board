  "contracts": {
    "VERSION": {
      "required": [
        "4.7.11"
      ]
    },
    "index.html": {
      "required": [
        "Sports Big Board \u2014 v4.7.11",
        "architecture/score-card-availability-index.js?v=4.7.11",
        "architecture/card-build-cache.js?v=4.7.11"
      ],
      "forbidden": [
        "?v=4.7.10"
      ]
    },
    "architecture/score-date-store.js": {
      "required": [
        "Sports Big Board v4.7.11 ScoreDateStore",
        "version:'1.0'",
        "do not clamp future scheduled dates to today"
      ],
      "forbidden": [
        "version:'1.1"
      ]
    },
    "sbb/day_state.py": {
      "required": [
        "def serve_thin_probe",
        "parsed.path == \"/api/day-state/thin\"",
        "\"X-SBB-Day-State\":\"THIN_PROBE\"",
        "\"errorType\":type(exc).__name__",
        "\"engineVersion\":\"4.7.11\""
      ]
    },
    "architecture/score-card-availability-index.js": {
      "required": [
        "Sports Big Board v4.7.11",
        "window.SBB_SCORECARD_AVAILABILITY_INDEX",
        "stableKey",
        "verifiedPlayableItemsForGame",
        "kind:'scheduled'",
        "kind:'thin-score-only'",
        "kind:'verified'",
        "originalPlayable(match)",
        "beginRender",
        "endRender"
      ]
    },
    "architecture/render-pipeline.js": {
      "required": [
        "Sports Big Board v4.7.11",
        "SBB_SCORECARD_AVAILABILITY_INDEX?.beginRender",
        "SBB_SCORECARD_AVAILABILITY_INDEX?.endRender",
        "availabilityFastHits",
        "availabilityFallbackMs"
      ]
    },
    "architecture/efficiency-certification.js": {
      "required": [
        "Sports Big Board v4.7.11",
        "/api/day-state/thin?date=",
        "AVAIL_INDEX_P95=",
        "AVAIL_FALLBACK_P95=",
        "AVAIL_FAST=",
        "AVAIL_FALLBACKS=",
        "http=${x.httpStatus",
        "error=${x.error",
        "message=${x.message"
      ]
    },
    "architecture/request-broker.js": {
      "required": [
        "Sports Big Board v4.7.11",
        "path==='/api/day-state/thin'"
      ]
    },
    "tests/test_v4710_cold_history_future_store_runtime.js": {
      "required": [
        "parts[2]>=10",
        "retains v4.7.10"
      ],
      "forbidden": [
        "assert.strictEqual(VERSION,'4.7.10')"
      ]
    },
    "tests/test_v4711_availability_index_thin_probe_runtime.js": {
      "required": [
        "thin-probe repair + render-scoped availability index contracts",
        "originalCalls,1",
        "stats.fastHits,2",
        "stats.fallbacks,1"
      ]
    },
    "tests/test_v4711_availability_index_thin_probe.py": {
      "required": [
        "test_thin_probe_has_dedicated_route_and_minimal_payload",
        "test_probe_report_exposes_server_error_details",
        "test_availability_index_keeps_unknown_fallback"
      ]
    },
    "tests/test_release_behavior_gate.py": {
      "required": [
        "test_thin_probe_uses_dedicated_minimal_day_state_route",
        "test_render_scoped_availability_index_preserves_certified_fallback",
        "test_efficiency_reports_availability_index_work",
        "node tests/test_v4711_availability_index_thin_probe_runtime.js"
      ]
    },
    "foundation-certification.json": {
      "required": [
        "\"release\": \"4.7.11\"",
        "dedicated GET /api/day-state/thin",
        "render-scoped Score-Card Availability Index",
        "ScoreDateStore public module API remains version 1.0"
      ]
    },
    "VERIFY.sh": {
      "required": [
        "node tests/test_v4711_availability_index_thin_probe_runtime.js",
        "python3 -m unittest tests.test_v4711_availability_index_thin_probe",
        "[legacy-advisory]"
      ]
    }
  },
  "verification": [
    "python3 tools/check_release_manifest.py",
    "python3 tools/check_release_version.py",
    "python3 tools/check_foundation_certification.py",
    "python3 tools/check_ultimate_playback.py",
    "python3 tools/check_deploy_rehearsal.py",
    "python3 -m unittest tests.test_v446_historical_media_quarantine",
    "python3 -m unittest tests.test_release_behavior_gate",
    "node tests/test_v473_efficiency_runtime.js",
    "node tests/test_v474_efficiency_remediation_runtime.js",
    "node tests/test_v475_enrichment_firewall_runtime.js",
    "node tests/test_v476_render_pipeline_runtime.js",
    "node tests/test_v477_first_paint_render_consolidation_runtime.js",
    "node tests/test_v478_future_projection_card_cache_runtime.js",
    "python3 -m unittest tests.test_v478_future_projection",
    "node tests/test_v479_navigation_history_runtime.js",
    "node tests/test_v4710_cold_history_future_store_runtime.js",
    "python3 -m unittest tests.test_v4710_cold_history_future_store",
    "node tests/test_v4711_availability_index_thin_probe_runtime.js",
    "python3 -m unittest tests.test_v4711_availability_index_thin_probe",
    "bash VERIFY.sh"
  ]
}
