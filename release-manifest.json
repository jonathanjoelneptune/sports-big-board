{
  "schemaVersion": 1,
  "release": "4.6.1",
  "baseRelease": "4.6.0",
  "title": "Competition Builder Persistence & Operator Workflow Hardening",
  "atomic": true,
  "requiredFiles": [
    "VERIFY.sh",
    "VERSION",
    "architecture/competition-builder.js",
    "core-model.js",
    "foundation-certification.json",
    "index.html",
    "release-manifest.json",
    "sbb/__init__.py",
    "sbb/competition_builder.py",
    "tests/test_v460_competition_builder.py",
    "tests/test_v461_competition_builder_hardening.py"
  ],
  "contracts": {
    "VERSION": {
      "required": [
        "4.6.1"
      ]
    },
    "index.html": {
      "required": [
        "Sports Big Board \u2014 v4.6.1",
        "app.js?v=4.6.1",
        "architecture/competition-builder.js?v=4.6.1",
        "architecture/recap-identity-guard.js?v=4.6.1",
        "architecture/nfl-recap-reconciliation.js?v=4.6.1"
      ],
      "forbidden": [
        "?v=4.6.0",
        "?v=4.5."
      ]
    },
    "core-model.js": {
      "required": [
        "version:'4.6.1'",
        "custom-competition overlay",
        "window.SBB_COMPETITION_BUILDER"
      ]
    },
    "foundation-certification.json": {
      "required": [
        "\"release\": \"4.6.1\"",
        "editable controls isolate keyboard input",
        "fresh definition read-back verifies persistence",
        "dedicated background media gap-search worker",
        "direct extraction of an operator-supplied official schedule URL"
      ]
    },
    "architecture/competition-builder.js": {
      "required": [
        "version:'1.1'",
        "CREATED SITE-WIDE \u2713",
        "Server read-back verification failed",
        "lastCatalogAt>5000",
        "matches?.('input,textarea,select')",
        "/api/competition-builder/definition",
        "sbbCompetitionList"
      ]
    },
    "sbb/__init__.py": {
      "required": [
        "competition_builder",
        "_install_competition_builder"
      ]
    },
    "sbb/competition_builder.py": {
      "required": [
        "Sports Big Board v4.6.1",
        "json_schema",
        "OFFICIAL_URL_EXTRACT",
        "_official_page_text",
        "os.fsync",
        "_store_revision",
        "_crawl_enrollment",
        "sbb-custom-competition-crawl",
        "SBB_CUSTOM_COMPETITION_CRAWL_INTERVAL"
      ]
    },
    "tests/test_v460_competition_builder.py": {
      "required": [
        "test_special_event_lifecycle_and_selector_placement",
        "test_schedule_normalizes_for_score_ribbon_and_game_center",
        "test_frontend_contracts_are_present"
      ]
    },
    "VERIFY.sh": {
      "required": [
        "python3 -m unittest tests.test_v461_competition_builder_hardening"
      ]
    },
    "tests/test_v461_competition_builder_hardening.py": {
      "required": [
        "test_keyboard_inputs_do_not_reach_playback_shortcuts",
        "test_save_is_durable_and_revisioned",
        "test_discovery_falls_back_to_official_page",
        "test_custom_competition_reports_crawl_enrollment"
      ]
    }
  },
  "verification": [
    "python3 tools/check_release_manifest.py",
    "python3 tools/check_release_version.py",
    "python3 tools/check_foundation_certification.py",
    "python3 tools/check_ultimate_playback.py",
    "python3 tools/check_deploy_rehearsal.py",
    "python3 -m unittest tests.test_v460_competition_builder",
    "python3 -m unittest tests.test_v461_competition_builder_hardening",
    "bash VERIFY.sh"
  ]
}
