{
  "schemaVersion": 1,
  "release": "4.6.3",
  "baseRelease": "4.6.2",
  "title": "Special Events Selector & Score Ribbon Integration",
  "atomic": true,
  "requiredFiles": [
    "VERIFY.sh",
    "VERSION",
    "architecture/competition-builder.js",
    "core-model.js",
    "foundation-certification.json",
    "index.html",
    "release-manifest.json",
    "sbb/__init__.py",
    "sbb/competition_builder.py",
    "tests/test_v460_competition_builder.py",
    "tests/test_v461_competition_builder_hardening.py",
    "tests/test_v462_competition_builder_research_delete.py",
    "tests/test_v463_special_event_ribbon.py"
  ],
  "contracts": {
    "VERSION": {
      "required": [
        "4.6.3"
      ]
    },
    "index.html": {
      "required": [
        "Sports Big Board \u2014 v4.6.3",
        "app.js?v=4.6.3",
        "architecture/competition-builder.js?v=4.6.3",
        "id=\"sbbSpecialEventsWrap\"",
        "id=\"sbbSpecialEventsBtn\"",
        "id=\"sbbSpecialEventsMenu\""
      ],
      "forbidden": [
        "?v=4.6.2",
        "?v=4.6.1",
        "?v=4.6.0",
        "?v=4.5."
      ]
    },
    "core-model.js": {
      "required": [
        "version:'4.6.3'",
        "custom-competition overlay",
        "window.SBB_COMPETITION_BUILDER"
      ]
    },
    "foundation-certification.json": {
      "required": [
        "\"release\": \"4.6.3\"",
        "permanent top-level selector control",
        "navigates the score ribbon into the event range",
        "canonical ScoreDateStore browse-date authority"
      ]
    },
    "architecture/competition-builder.js": {
      "required": [
        "version:'1.3'",
        "sbbSpecialEventsWrap",
        "menu.innerHTML=''",
        "window.SBB_SCORE_DATE?.subscribe",
        "meta?.action==='browse'",
        "if(c.endDate&&targetDate>c.endDate)targetDate=c.endDate",
        "setScoreBrowseDate(targetDate",
        "SCORE_DATE_STORE?.setMatches?.(date,c.id,rows)"
      ]
    },
    "sbb/__init__.py": {
      "required": [
        "competition_builder",
        "_install_competition_builder"
      ]
    },
    "sbb/competition_builder.py": {
      "required": [
        "Sports Big Board v4.6.2",
        "_discovery_plan",
        "_date_windows",
        "_merge_discovered_events",
        "MULTI_WINDOW_RESEARCH",
        "_missing_recovery_prompt",
        "Cannot create a site-wide competition with zero schedule events",
        "delete_competition",
        "_purge_history_competition",
        "_remove_operator_playlists"
      ]
    },
    "tests/test_v460_competition_builder.py": {
      "required": [
        "test_special_event_lifecycle_and_selector_placement",
        "test_schedule_normalizes_for_score_ribbon_and_game_center",
        "test_frontend_contracts_are_present"
      ]
    },
    "VERIFY.sh": {
      "required": [
        "python3 -m unittest tests.test_v461_competition_builder_hardening",
        "python3 -m unittest tests.test_v462_competition_builder_research_delete",
        "python3 -m unittest tests.test_v463_special_event_ribbon"
      ]
    },
    "tests/test_v461_competition_builder_hardening.py": {
      "required": [
        "test_keyboard_inputs_do_not_reach_playback_shortcuts",
        "test_save_is_durable_and_revisioned",
        "test_discovery_falls_back_to_official_page",
        "test_custom_competition_reports_crawl_enrollment"
      ]
    },
    "tests/test_v462_competition_builder_research_delete.py": {
      "required": [
        "test_world_cup_uses_bounded_windows",
        "test_zero_and_partial_schedule_cannot_activate",
        "test_delete_is_site_wide_and_purges_custom_history",
        "CONFIRM DELETE"
      ]
    },
    "tests/test_v463_special_event_ribbon.py": {
      "required": [
        "test_special_events_control_is_permanent_header_ui",
        "test_completed_special_event_selection_navigates_into_event_range",
        "test_custom_scores_follow_score_date_store_browse_authority"
      ]
    }
  },
  "verification": [
    "python3 tools/check_release_manifest.py",
    "python3 tools/check_release_version.py",
    "python3 tools/check_foundation_certification.py",
    "python3 tools/check_ultimate_playback.py",
    "python3 tools/check_deploy_rehearsal.py",
    "python3 -m unittest tests.test_v460_competition_builder",
    "python3 -m unittest tests.test_v461_competition_builder_hardening",
    "python3 -m unittest tests.test_v462_competition_builder_research_delete",
    "python3 -m unittest tests.test_v463_special_event_ribbon",
    "bash VERIFY.sh"
  ]
}
