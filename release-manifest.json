{
  "schemaVersion": 1,
  "release": "4.7.3",
  "baseRelease": "4.7.2",
  "title": "Efficiency Instrumentation + Automated Efficiency Certification",
  "atomic": true,
  "requiredFiles": [
    "VERIFY.sh",
    "VERSION",
    "index.html",
    "core-model.js",
    "foundation-certification.json",
    "release-manifest.json",
    "sbb/day_state.py",
    "architecture/day-state.js",
    "architecture/competition-registry-projection.js",
    "architecture/efficiency-certification.js",
    "tests/test_release_behavior_gate.py",
    "tests/test_v473_efficiency_runtime.js"
  ],
  "contracts": {
    "VERSION": {
      "required": [
        "4.7.3"
      ]
    },
    "index.html": {
      "required": [
        "Sports Big Board \u2014 v4.7.3",
        "api-runtime.js?v=4.7.3",
        "architecture/efficiency-certification.js?v=4.7.3",
        "core-model.js?v=4.7.3",
        "architecture/day-state.js?v=4.7.3",
        "architecture/competition-registry-projection.js?v=4.7.3",
        "id=\"launchPlayBtn\""
      ],
      "forbidden": [
        "?v=4.7.2"
      ]
    },
    "core-model.js": {
      "required": [
        "version:'4.7.3'",
        "SBB_FRONTEND_REGISTRY?.competitionMap?.()"
      ]
    },
    "sbb/day_state.py": {
      "required": [
        "COLD_WARMING",
        "STALE_REFRESHING",
        "\"engineVersion\":\"4.7.3\""
      ]
    },
    "architecture/day-state.js": {
      "required": [
        "Sports Big Board v4.7.3",
        "fallback(date)"
      ]
    },
    "architecture/competition-registry-projection.js": {
      "required": [
        "Sports Big Board v4.7.3",
        "specialRenderKey",
        "leagueRenderKey"
      ],
      "forbidden": [
        "new MutationObserver",
        ".observe(document.documentElement"
      ]
    },
    "architecture/efficiency-certification.js": {
      "required": [
        "Sports Big Board v4.7.3",
        "window.SBB_EFFICIENCY",
        "RUN AUTO TEST",
        "RUN HAMMER",
        "PerformanceObserver",
        "'longtask'",
        "duplicateConcurrent",
        "ribbonP95",
        "apiP95",
        "heapGrowthPct",
        "domGrowthPct",
        "restoreState",
        "current state will be restored",
        "/api/day-state",
        "/api/competition-registry",
        "/api/competition-builder/catalog"
      ],
      "forbidden": [
        "new MutationObserver",
        "method:'POST'",
        "method:\"POST\""
      ]
    },
    "tests/test_release_behavior_gate.py": {
      "required": [
        "class ReleaseBehaviorGate",
        "test_efficiency_certification_is_loaded_and_non_destructive",
        "test_active_foundation_checker_contracts_remain_blocking",
        "node tests/test_v473_efficiency_runtime.js",
        "tests.test_v446_historical_media_quarantine"
      ]
    },
    "tests/test_v473_efficiency_runtime.js": {
      "required": [
        "v4.7.3 efficiency instrumentation + automated certification contracts",
        "runAutoTest",
        "runHammer",
        "restoreState",
        "duplicateConcurrent",
        "heapGrowthPct",
        "domGrowthPct"
      ]
    },
    "foundation-certification.json": {
      "required": [
        "\"release\": \"4.7.3\"",
        "Efficiency Certification",
        "RUN AUTO TEST",
        "ribbon p50/p95/max",
        "backend read-only",
        "tests/test_v473_efficiency_runtime.js"
      ]
    },
    "VERIFY.sh": {
      "required": [
        "python3 tools/check_release_manifest.py",
        "python3 tools/check_release_version.py",
        "python3 tools/check_foundation_certification.py",
        "python3 tools/check_ultimate_playback.py",
        "python3 tools/check_deploy_rehearsal.py",
        "python3 -m unittest tests.test_v446_historical_media_quarantine",
        "python3 -m unittest tests.test_release_behavior_gate",
        "node tests/test_v473_efficiency_runtime.js",
        "[legacy-advisory]",
        "does not block deployment"
      ]
    }
  },
  "verification": [
    "python3 tools/check_release_manifest.py",
    "python3 tools/check_release_version.py",
    "python3 tools/check_foundation_certification.py",
    "python3 tools/check_ultimate_playback.py",
    "python3 tools/check_deploy_rehearsal.py",
    "python3 -m unittest tests.test_v446_historical_media_quarantine",
    "python3 -m unittest tests.test_release_behavior_gate",
    "node tests/test_v473_efficiency_runtime.js",
    "bash VERIFY.sh"
  ]
}
