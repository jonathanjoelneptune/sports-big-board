{
  "schemaVersion": 1,
  "release": "4.5.5",
  "baseRelease": "4.5.4",
  "title": "YouTube Media Intelligence Reliability",
  "atomic": true,
  "requiredFiles": [
    "VERSION",
    "index.html",
    "core-model.js",
    "foundation-certification.json",
    "release-manifest.json",
    "VERIFY.sh",
    "architecture/media-intelligence.js",
    "architecture/media-intelligence-console.js",
    "architecture/playback-terminal.js",
    "sbb/__init__.py",
    "sbb/media_intelligence.py",
    "sbb/media_intelligence_control.py",
    "tests/test_v434_deploy_rehearsal.py",
    "tests/test_v450_media_intelligence.py",
    "tests/test_v450_media_intelligence_runtime.js",
    "tests/test_v451_startup_stability_runtime.js",
    "tests/test_v452_media_intelligence_visibility.py",
    "tests/test_v452_media_intelligence_console_runtime.js",
    "tests/test_v453_media_intelligence_terminal.py",
    "tests/test_v453_media_intelligence_terminal_runtime.js",
    "tests/test_v454_media_intelligence_crawl.py",
    "tools/check_release_manifest.py",
    "tools/check_deploy_rehearsal.py",
    "cloud/gcp/DEPLOY-FROM-GITHUB.sh",
    "cloud/vm/INSTALL-STAGE1.sh",
    "tests/test_v455_youtube_media_intelligence.py",
    "tools/check_ultimate_playback.py"
  ],
  "contracts": {
    "VERSION": {
      "required": [
        "4.5.5"
      ]
    },
    "index.html": {
      "required": [
        "Sports Big Board \u2014 v4.5.5",
        "architecture/playback-terminal.js?v=4.5.5",
        "architecture/media-intelligence-console.js?v=4.5.5",
        "<span>MUSIC</span>",
        "<span>SITE MUSIC</span>"
      ],
      "forbidden": [
        "?v=4.5.4"
      ]
    },
    "core-model.js": {
      "required": [
        "version:'4.5.5'"
      ]
    },
    "foundation-certification.json": {
      "required": [
        "\"release\": \"4.5.5\"",
        "Media Intelligence",
        "stable yt-dlp and Deno",
        "FORMAT_UNAVAILABLE"
      ]
    },
    "architecture/media-intelligence.js": {
      "required": [
        "scheduleAudibleTruth",
        "installNativeGuards",
        "preloadBlocks",
        "abortMatchingResources",
        "version:'1.1'"
      ],
      "forbidden": [
        "new MutationObserver("
      ]
    },
    "architecture/media-intelligence-console.js": {
      "required": [
        "PROCESSED",
        "CLASSIFIED",
        "PENDING FRESH",
        "SCAN FAILURES",
        "failureReasons",
        "attemptedAt",
        "FAILURE TYPE",
        "overflow-y:auto!important",
        "foreground trickle=",
        "ytDlpVersion",
        "deno="
      ]
    },
    "architecture/playback-terminal.js": {
      "required": [
        "playback-terminal-auto",
        "MCONF=",
        "MRATIO=",
        "MSCAN=",
        "SITE_MUSIC=",
        "priority:250",
        "enrichMediaIntel(row,{autoQueue:true})",
        "musicFailureKind"
      ]
    },
    "sbb/media_intelligence.py": {
      "required": [
        "MUSIC_FOREGROUND_TRICKLE_SECONDS",
        "fresh unprocessed assets",
        "FORMAT_UNAVAILABLE",
        "--js-runtimes",
        "inventory-fallback",
        "youtubeAudioFormatCount",
        "v4.5.5-youtube-repair",
        "ytDlpVersion",
        "\"deno\": bool(self.deno)"
      ]
    },
    "sbb/media_intelligence_control.py": {
      "required": [
        "recentFailures",
        "store.list_assets('SCAN_FAILED',5)",
        "/api/media-intelligence/status",
        "/api/media-intelligence/scan"
      ]
    },
    "VERIFY.sh": {
      "required": [
        "tests.test_v453_media_intelligence_terminal",
        "test_v453_media_intelligence_terminal_runtime.js",
        "tests.test_v454_media_intelligence_crawl",
        "tests.test_v455_youtube_media_intelligence"
      ]
    },
    "tools/check_release_manifest.py": {
      "required": [
        "CHANGED-FILES-vX.X.X.txt files are intentionally ignored"
      ]
    },
    "tools/check_deploy_rehearsal.py": {
      "required": [
        "CHANGED-FILES-vX.X.X.txt bookkeeping is never read",
        "CHANGED-FILES ignored"
      ],
      "forbidden": [
        "overlay_manifest_check",
        "CHANGED-FILES-v{VERSION}.txt"
      ]
    },
    "cloud/gcp/DEPLOY-FROM-GITHUB.sh": {
      "required": [
        "Refreshing Media Intelligence runtime dependencies",
        "yt-dlp/yt-dlp/releases/latest/download/yt-dlp",
        "denoland/deno/releases/latest/download/deno-",
        "/usr/local/bin/yt-dlp",
        "/usr/local/bin/deno"
      ]
    },
    "cloud/vm/INSTALL-STAGE1.sh": {
      "required": [
        "stable yt-dlp plus Deno",
        "yt-dlp/yt-dlp/releases/latest/download/yt-dlp",
        "denoland/deno/releases/latest/download/deno-",
        "install -m 0755 \"$MEDIA_TOOL_TMP/yt-dlp\" /usr/local/bin/yt-dlp",
        "install -m 0755 \"$MEDIA_TOOL_TMP/deno/deno\" /usr/local/bin/deno"
      ]
    },
    "tests/test_v455_youtube_media_intelligence.py": {
      "required": [
        "inventory_audio_fallback",
        "FORMAT_UNAVAILABLE",
        "v4.5.5-youtube-repair",
        "denoland/deno/releases/latest/download/deno-"
      ]
    },
    "tools/check_ultimate_playback.py": {
      "required": [
        "yt-dlp/yt-dlp/releases/latest/download/yt-dlp",
        "denoland/deno/releases/latest/download/deno-",
        "Media Intelligence runtime dependency contract"
      ],
      "forbidden": [
        "apt-get install -y ffmpeg yt-dlp' in deploy"
      ]
    }
  },
  "verification": [
    "python3 tools/check_release_manifest.py",
    "python3 tools/check_release_version.py",
    "python3 tools/check_foundation_certification.py",
    "python3 tools/check_ultimate_playback.py",
    "python3 tools/check_deploy_rehearsal.py",
    "python3 -m unittest tests.test_v450_media_intelligence",
    "python3 -m unittest tests.test_v452_media_intelligence_visibility",
    "python3 -m unittest tests.test_v453_media_intelligence_terminal",
    "node tests/test_v451_startup_stability_runtime.js",
    "node tests/test_v452_media_intelligence_console_runtime.js",
    "node tests/test_v453_media_intelligence_terminal_runtime.js",
    "python3 -m unittest tests.test_v454_media_intelligence_crawl",
    "python3 -m unittest tests.test_v455_youtube_media_intelligence",
    "bash VERIFY.sh"
  ]
}
