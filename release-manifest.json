  "contracts": {
    "VERSION": {
      "required": [
        "4.7.14"
      ]
    },
    "index.html": {
      "required": [
        "Sports Big Board \u2014 v4.7.14",
        "core-model.js?v=4.7.14",
        "architecture/day-state.js?v=4.7.14"
      ],
      "forbidden": [
        "?v=4.7.13"
      ]
    },
    "core-model.js": {
      "required": [
        "version:'4.7.14'",
        "CFB:{id:'CFB'",
        "seasonId:'CFB2026'",
        "scoreProvider:'cfb-ranked'",
        "rankingSnapshotPolicy:'IMMUTABLE_WEEKLY'"
      ]
    },
    "sbb/cfb_ranked.py": {
      "required": [
        "AP Top 25 College Football season service",
        "COMPETITION_ID='CFB'",
        "SEASON_ID='CFB2026'",
        "if not away_rank and not home_rank:continue",
        "rankingFrozen':True",
        "Immutable weekly archive",
        "PLPydJJjt7Pb4",
        "titleIncludePhrase':'full game highlights'",
        "'/api/cfb/status'",
        "'/api/cfb/rankings'",
        "'/api/cfb/refresh'",
        "builder.save_competition"
      ]
    },
    "sbb/day_state.py": {
      "required": [
        "\"engineVersion\":\"4.7.14\"",
        "from . import cfb_ranked as _cfb_ranked",
        "_cfb_ranked.install()"
      ]
    },
    "tests/test_v4714_cfb_ranked_season.py": {
      "required": [
        "test_cfb_is_first_class_persistent_league",
        "test_archived_rank_snapshot_is_immutable",
        "test_future_weeks_are_not_projected_using_old_rankings",
        "test_playlist_is_purple_extended_source"
      ]
    },
    "tests/test_v4714_cfb_ranked_runtime.py": {
      "required": [
        "test_espn_rankings_and_fbs_scoreboard_are_separate_authorities",
        "test_score_refresh_does_not_change_rank_snapshot",
        "test_diagnostics_and_manual_refresh_exist"
      ]
    },
    "tests/test_release_behavior_gate.py": {
      "required": [
        "test_cfb_ap_top25_weekly_snapshot_contract",
        "test_cfb_is_persistent_first_class_frontend_competition",
        "test_cfb_playlist_and_diagnostics_contract",
        "tests.test_v4714_cfb_ranked_season"
      ]
    },
    "foundation-certification.json": {
      "required": [
        "\"release\": \"4.7.14\"",
        "weekly AP Top 25 snapshot",
        "ranked-v-ranked games appear once",
        "Future CFB weeks are never projected"
      ]
    },
    "VERIFY.sh": {
      "required": [
        "python3 -m unittest tests.test_v4714_cfb_ranked_season",
        "python3 -m unittest tests.test_v4714_cfb_ranked_runtime",
        "[legacy-advisory]"
      ]
    }
  },
  "verification": [
