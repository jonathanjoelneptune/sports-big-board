{
  "schemaVersion": 1,
  "release": "4.6.12",
  "baseRelease": "4.6.11",
  "title": "Generic Schedule Template + Playlist Match Rules",
  "atomic": true,
  "requiredFiles": [
    "VERIFY.sh",
    "VERSION",
    "index.html",
    "core-model.js",
    "foundation-certification.json",
    "sbb/__init__.py",
    "sbb/competition_builder_v4612.py",
    "architecture/competition-builder-v4612.js",
    "tests/test_v4611_llws_event_icons.py",
    "tests/test_v4612_schedule_template_playlist_matching.py"
  ],
  "contracts": {
    "VERSION": {
      "required": [
        "4.6.12"
      ]
    },
    "index.html": {
      "required": [
        "Sports Big Board \u2014 v4.6.12",
        "core-model.js?v=4.6.12",
        "app.js?v=4.6.12",
        "architecture/competition-builder-v4611.js?v=4.6.12",
        "architecture/competition-builder-v4612.js?v=4.6.12",
        "architecture/historical-media-v4610.js?v=4.6.12"
      ],
      "forbidden": [
        "?v=4.6.11"
      ]
    },
    "core-model.js": {
      "required": [
        "version:'4.6.12'",
        "custom-competition overlay"
      ]
    },
    "foundation-certification.json": {
      "required": [
        "\"release\": \"4.6.12\"",
        "COPY TEMPLATE JSON",
        "required/excluded playlist title phrases",
        "participant aliases"
      ]
    },
    "sbb/__init__.py": {
      "required": [
        "competition_builder_v4612",
        "_install_competition_builder_v4612()"
      ]
    },
    "sbb/competition_builder_v4612.py": {
      "required": [
        "Sports Big Board v4.6.12",
        "requiredTitlePhrases",
        "excludedTitlePhrases",
        "def _wrap_server_matcher",
        "PLAYLIST_TITLE_RULE",
        "participantAliasMatch",
        "def _update_media_rules",
        "force_crawl=True"
      ]
    },
    "architecture/competition-builder-v4612.js": {
      "required": [
        "Sports Big Board v4.6.12",
        "COPY TEMPLATE JSON",
        "GENERIC_SCHEDULE_TEMPLATE",
        "cbGreenRequiredTitlePhrases",
        "historyMediaPlaylistRequiredTitlePhrases",
        "/api/competition-builder/media-rules",
        "Full Game Highlights",
        "aliases",
        "providerEventId"
      ]
    },
    "tests/test_v4610_historical_media_association.py": {
      "required": [
        "VERSION = (ROOT / \"VERSION\").read_text(encoding=\"utf-8\").strip()",
        "f\"architecture/historical-media-v4610.js?v={VERSION}\""
      ]
    },
    "tests/test_v4611_llws_event_icons.py": {
      "required": [
        "VERSION = (ROOT / \"VERSION\").read_text(encoding=\"utf-8\").strip()",
        "f\"architecture/competition-builder-v4611.js?v={VERSION}\"",
        "self.assertIn(\"kind === 'LLWS'\", UI)"
      ],
      "forbidden": [
        "data-builder-template=\\\\\"LLWS\\\\\""
      ]
    },
    "tests/test_v4612_schedule_template_playlist_matching.py": {
      "required": [
        "test_generic_schedule_template_copy_contract",
        "test_playlist_title_rule_fields_are_reusable",
        "test_title_rules_accept_full_game_and_reject_nonmatching_clips",
        "test_participant_aliases_include_group_and_media_names",
        "test_imported_participant_objects_preserve_alias_metadata"
      ]
    },
    "VERIFY.sh": {
      "required": [
        "python3 tools/check_release_manifest.py",
        "python3 tools/check_release_version.py",
        "python3 tools/check_foundation_certification.py",
        "python3 -m unittest tests.test_v4610_historical_media_association",
        "python3 -m unittest tests.test_v4611_llws_event_icons",
        "python3 -m unittest tests.test_v4612_schedule_template_playlist_matching"
      ]
    }
  },
  "verification": [
    "python3 tools/check_release_manifest.py",
    "python3 tools/check_release_version.py",
    "python3 tools/check_foundation_certification.py",
    "python3 tools/check_ultimate_playback.py",
    "python3 tools/check_deploy_rehearsal.py",
    "python3 -m unittest tests.test_v4610_historical_media_association",
    "python3 -m unittest tests.test_v4611_llws_event_icons",
    "python3 -m unittest tests.test_v4612_schedule_template_playlist_matching",
    "bash VERIFY.sh"
  ]
}
