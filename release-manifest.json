{
  "schemaVersion": 1,
  "release": "4.7.7",
  "baseRelease": "4.7.6",
  "title": "First-Paint Certification + Render Consolidation",
  "atomic": true,
  "requiredFiles": [
    "VERIFY.sh",
    "VERSION",
    "index.html",
    "core-model.js",
    "foundation-certification.json",
    "release-manifest.json",
    "sbb/day_state.py",
    "architecture/request-broker.js",
    "architecture/date-transition-coordinator.js",
    "architecture/day-state.js",
    "architecture/competition-registry-projection.js",
    "architecture/efficiency-certification.js",
    "architecture/historical-media-v4610.js",
    "architecture/operator-module-loader.js",
    "architecture/future-date-navigation.js",
    "architecture/render-pipeline.js",
    "tests/test_release_behavior_gate.py",
    "tests/test_v472_frontend_boot_responsiveness.py",
    "tests/test_v473_efficiency_runtime.js",
    "tests/test_v474_efficiency_remediation_runtime.js",
    "tests/test_v475_enrichment_firewall_runtime.js",
    "tests/test_v476_render_pipeline_runtime.js",
    "tests/test_v477_first_paint_render_consolidation_runtime.js"
  ],
  "contracts": {
    "VERSION": {
      "required": [
        "4.7.7"
      ]
    },
    "index.html": {
      "required": [
        "Sports Big Board \u2014 v4.7.7",
        "architecture/render-pipeline.js?v=4.7.7",
        "architecture/date-transition-coordinator.js?v=4.7.7"
      ],
      "forbidden": [
        "?v=4.7.6"
      ]
    },
    "architecture/render-pipeline.js": {
      "required": [
        "Sports Big Board v4.7.7",
        "beginGeneration",
        "commitGeneration",
        "generation-hold",
        "generationCommit:true",
        "document.createDocumentFragment()",
        "fragmentCommits",
        "buildMs",
        "commitMs",
        "emit('paint'",
        "reasonCounts"
      ]
    },
    "architecture/date-transition-coordinator.js": {
      "required": [
        "Sports Big Board v4.7.7",
        "SBB_RENDER_PIPELINE?.beginGeneration",
        "SBB_RENDER_PIPELINE?.commitGeneration",
        "transition owns exactly one first-paint ribbon commit"
      ],
      "forbidden": [
        "withReason?.('cold-ribbon-fallback'"
      ]
    },
    "architecture/day-state.js": {
      "required": [
        "Sports Big Board v4.7.7",
        "SBB_RENDER_PIPELINE.request('day-state-apply'",
        "RIBBON_RENDER_REQUEST"
      ]
    },
    "architecture/efficiency-certification.js": {
      "required": [
        "Sports Big Board v4.7.7",
        "function ribbonFirstUsable",
        "function ribbonFullySettled",
        "firstPaintMs",
        "settleTimeout",
        "First paint p95",
        "First-paint timeouts",
        "FULL_SETTLE_TIMEOUTS=",
        "CARD_BUILD_P95=",
        "DOM_COMMIT_P95=",
        "BROWSER_PAINT_P95=",
        "RENDER_REASONS="
      ]
    },
    "tests/test_v476_render_pipeline_runtime.js": {
      "required": [
        "parts[2]>=6",
        "retains v4.7.6"
      ],
      "forbidden": [
        "assert.strictEqual(VERSION,'4.7.6')"
      ]
    },
    "tests/test_v477_first_paint_render_consolidation_runtime.js": {
      "required": [
        "first-paint certification + generation render consolidation contracts",
        "beginGeneration",
        "commitGeneration",
        "DocumentFragment",
        "CARD_BUILD_P95="
      ]
    },
    "tests/test_release_behavior_gate.py": {
      "required": [
        "test_date_transition_has_one_generation_owned_first_paint_commit",
        "test_ribbon_cards_are_batched_off_dom_before_commit",
        "test_efficiency_certifies_first_usable_paint_not_background_settle",
        "node tests/test_v477_first_paint_render_consolidation_runtime.js"
      ]
    },
    "foundation-certification.json": {
      "required": [
        "\"release\": \"4.7.7\"",
        "one Render Pipeline generation",
        "DocumentFragment",
        "first usable canonical score-card paint",
        "tests/test_v477_first_paint_render_consolidation_runtime.js"
      ]
    },
    "VERIFY.sh": {
      "required": [
        "python3 -m unittest tests.test_v446_historical_media_quarantine",
        "python3 -m unittest tests.test_release_behavior_gate",
        "node tests/test_v476_render_pipeline_runtime.js",
        "node tests/test_v477_first_paint_render_consolidation_runtime.js",
        "[legacy-advisory]"
      ]
    }
  },
  "verification": [
    "python3 tools/check_release_manifest.py",
    "python3 tools/check_release_version.py",
    "python3 tools/check_foundation_certification.py",
    "python3 tools/check_ultimate_playback.py",
    "python3 tools/check_deploy_rehearsal.py",
    "python3 -m unittest tests.test_v446_historical_media_quarantine",
    "python3 -m unittest tests.test_release_behavior_gate",
    "node tests/test_v473_efficiency_runtime.js",
    "node tests/test_v474_efficiency_remediation_runtime.js",
    "node tests/test_v475_enrichment_firewall_runtime.js",
    "node tests/test_v476_render_pipeline_runtime.js",
    "node tests/test_v477_first_paint_render_consolidation_runtime.js",
    "bash VERIFY.sh"
  ]
}
