{
  "schemaVersion": 1,
  "release": "4.6.15",
  "baseRelease": "4.6.14",
  "title": "Persistence-Aware Special Event Association",
  "atomic": true,
  "requiredFiles": [
    "VERIFY.sh",
    "VERSION",
    "index.html",
    "core-model.js",
    "foundation-certification.json",
    "release-manifest.json",
    "sbb/__init__.py",
    "sbb/competition_builder_v4615.py",
    "tests/test_v4614_media_facing_participant_aliases.py",
    "tests/test_v4615_persistence_aware_special_event_association.py"
  ],
  "contracts": {
    "VERSION": {
      "required": [
        "4.6.15"
      ]
    },
    "index.html": {
      "required": [
        "Sports Big Board \u2014 v4.6.15",
        "core-model.js?v=4.6.15",
        "app.js?v=4.6.15",
        "architecture/competition-builder-v4613.js?v=4.6.15",
        "architecture/historical-media-v4610.js?v=4.6.15"
      ],
      "forbidden": [
        "?v=4.6.14"
      ]
    },
    "core-model.js": {
      "required": [
        "version:'4.6.15'",
        "custom-competition overlay"
      ]
    },
    "foundation-certification.json": {
      "required": [
        "\"release\": \"4.6.15\"",
        "Persistence accepts a deterministic special-event proof",
        "SPECIAL_EVENT_TITLE_ALIAS_PAIR proof is not reinterpreted",
        "MULTI_EVENT_CANDIDATE_ENCOUNTER"
      ]
    },
    "sbb/__init__.py": {
      "required": [
        "competition_builder_v4615",
        "_install_competition_builder_v4615()"
      ]
    },
    "sbb/competition_builder_v4615.py": {
      "required": [
        "Sports Big Board v4.6.15",
        "sbbPreprovenAssociation",
        "SBB_SPECIAL_EVENT_MATCHER",
        "def _trusted_proof",
        "def _persist_one_preproven",
        "HistoryRepository.put_event_media = _put_event_media_v4615",
        "HistoryRepository.repair_event_associations = _repair_event_associations_v4615",
        "MULTI_EVENT_CANDIDATE_ENCOUNTER",
        "sbb-v4615-preproven-quarantine-release"
      ]
    },
    "tests/test_v4614_media_facing_participant_aliases.py": {
      "required": [
        "VERSION=(ROOT/\"VERSION\").read_text(encoding=\"utf-8\").strip()",
        "self.assertIn(f\"Sports Big Board \u2014 v{VERSION}\",INDEX)"
      ],
      "forbidden": [
        "self.assertIn(\"Sports Big Board \u2014 v4.6.14\",INDEX)"
      ]
    },
    "tests/test_v4615_persistence_aware_special_event_association.py": {
      "required": [
        "test_legacy_matcher_rejects_geographic_title_against_club_names",
        "test_trusted_special_event_proof_persists_as_assigned",
        "test_existing_title_team_pair_quarantine_is_released_after_exact_reproof",
        "test_mismatched_canonical_key_cannot_bypass_legacy_matcher",
        "test_proven_asset_cannot_steal_an_existing_different_assignment",
        "test_relationship_repair_restores_still_valid_preproven_link"
      ]
    },
    "VERIFY.sh": {
      "required": [
        "python3 tools/check_release_manifest.py",
        "python3 tools/check_release_version.py",
        "python3 tools/check_foundation_certification.py",
        "python3 -m unittest tests.test_v4614_media_facing_participant_aliases",
        "python3 -m unittest tests.test_v4615_persistence_aware_special_event_association"
      ]
    }
  },
  "verification": [
    "python3 tools/check_release_manifest.py",
    "python3 tools/check_release_version.py",
    "python3 tools/check_foundation_certification.py",
    "python3 tools/check_ultimate_playback.py",
    "python3 tools/check_deploy_rehearsal.py",
    "python3 -m unittest tests.test_v4614_media_facing_participant_aliases",
    "python3 -m unittest tests.test_v4615_persistence_aware_special_event_association",
    "bash VERIFY.sh"
  ]
}
