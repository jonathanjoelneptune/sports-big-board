{
  "schemaVersion": 1,
  "release": "4.4.6",
  "baseRelease": "4.4.5",
  "title": "Historical Media Quarantine & Graceful Fallback",
  "atomic": true,
  "requiredFiles": [
    "VERSION",
    "index.html",
    "core-model.js",
    "architecture/playback-terminal.js",
    "foundation-certification.json",
    "VERIFY.sh",
    "tools/check_ultimate_playback.py",
    "tests/test_v443_playback_endurance.py",
    "tests/test_v443_playback_endurance.js",
    "tests/test_v444_mixed_media_soak.py",
    "tests/test_v444_playback_recovery_runtime.js",
    "tests/test_v445_random_archive_stress.py",
    "tests/test_v446_historical_media_quarantine.py",
    "tests/test_v446_stale_media_runtime.js",
    "release-manifest.json",
    "CHANGED-FILES-v4.4.6.txt"
  ],
  "contracts": {
    "VERSION": {
      "required": [
        "4.4.6"
      ]
    },
    "index.html": {
      "required": [
        "Sports Big Board \u2014 v4.4.6",
        "START 60M",
        "START 30M RECOVERY",
        "random archive dates across 365 days",
        "FIND RECAP/no media skipped",
        "app.js?v=4.4.6",
        "architecture/playback-terminal.js?v=4.4.6"
      ],
      "forbidden": [
        "?v=4.4.5"
      ]
    },
    "core-model.js": {
      "required": [
        "version:'4.4.6'"
      ]
    },
    "architecture/playback-terminal.js": {
      "required": [
        "RECOVERY_PHASES",
        "RECOVERY_TOTAL_MS",
        "preferNFL:true",
        "startRecovery",
        "STALE_MEDIA",
        "NO_MEDIA_SKIP",
        "quarantineStaleMedia",
        "markRuntimeMediaFailed",
        "tryScoreMediaFallback",
        "HTTP 410 stale historical media",
        "providerFailure:false",
        "fallbackSuccesses",
        "quarantineReselections",
        "QUARANTINED_MEDIA_RESELECTED",
        "ARCHIVE_LOOKBACK_DAYS=365",
        "filter(r=>r.enduranceRunId===s.runId)"
      ]
    },
    "foundation-certification.json": {
      "required": [
        "\"release\": \"4.4.6\""
      ]
    },
    "VERIFY.sh": {
      "required": [
        "python3 tools/check_release_manifest.py",
        "python3 -m unittest tests.test_v446_historical_media_quarantine",
        "node tests/test_v446_stale_media_runtime.js",
        "node tests/test_v444_playback_recovery_runtime.js"
      ]
    },
    "tools/check_ultimate_playback.py": {
      "required": [
        "v4.4.6 historical-media quarantine + graceful recovery",
        "v4.4.6 stale-media runtime test"
      ]
    },
    "tests/test_v444_mixed_media_soak.py": {
      "required": [
        "markRuntimeMediaFailed"
      ]
    },
    "tests/test_v444_playback_recovery_runtime.js": {
      "required": [
        "one stale-asset retry must not reset the whole playback engine",
        "assert.equal(resetCalls,0"
      ]
    },
    "tests/test_v445_random_archive_stress.py": {
      "required": [
        "test_release_baseline_or_newer",
        "self.assertGreaterEqual(tuple(map(int,VERSION.split"
      ],
      "forbidden": [
        "self.assertEqual(VERSION,'4.4.5')"
      ]
    },
    "tests/test_v446_historical_media_quarantine.py": {
      "required": [
        "START 30M RECOVERY",
        "STALE_MEDIA",
        "NO_MEDIA_SKIP",
        "QUARANTINED_MEDIA_RESELECTED"
      ]
    },
    "tests/test_v446_stale_media_runtime.js": {
      "required": [
        "two failures of one historical asset should quarantine, not fail certification",
        "fallbackSuccesses"
      ]
    },
    "tests/test_v443_playback_endurance.py": {
      "required": [
        "markRuntimeMediaFailed",
        "self.assertNotIn('forcePlaybackEngineReset?.()',TERM)"
      ],
      "forbidden": [
        "self.assertIn('forcePlaybackEngineReset',TERM)"
      ]
    },
    "tests/test_v443_playback_endurance.js": {
      "required": [
        "markRuntimeMediaFailed",
        "single stale asset must not reset the entire playback engine"
      ],
      "forbidden": [
        "terminal.includes('forcePlaybackEngineReset')"
      ]
    }
  },
  "verification": [
    "python3 tools/check_release_manifest.py",
    "python3 tools/check_release_version.py",
    "python3 tools/check_foundation_certification.py",
    "python3 tools/check_ultimate_playback.py",
    "python3 tools/check_deploy_rehearsal.py",
    "python3 -m unittest tests.test_v446_historical_media_quarantine",
    "node tests/test_v446_stale_media_runtime.js",
    "bash VERIFY.sh"
  ]
}
