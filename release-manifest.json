{
  "schemaVersion": 1,
  "release": "4.7.2",
  "baseRelease": "4.7.1",
  "title": "Frontend Boot Responsiveness",
  "atomic": true,
  "requiredFiles": [
    "VERIFY.sh",
    "VERSION",
    "index.html",
    "core-model.js",
    "foundation-certification.json",
    "release-manifest.json",
    "sbb/day_state.py",
    "architecture/day-state.js",
    "architecture/competition-registry-projection.js",
    "tests/test_v471_day_state_registry_resilience.py",
    "tests/test_v472_frontend_boot_responsiveness.py"
  ],
  "contracts": {
    "VERSION": {
      "required": [
        "4.7.2"
      ]
    },
    "index.html": {
      "required": [
        "Sports Big Board \u2014 v4.7.2",
        "core-model.js?v=4.7.2",
        "app.js?v=4.7.2",
        "architecture/day-state.js?v=4.7.2",
        "architecture/competition-registry-projection.js?v=4.7.2",
        "id=\"launchPlayBtn\""
      ],
      "forbidden": [
        "?v=4.7.1"
      ]
    },
    "core-model.js": {
      "required": [
        "version:'4.7.2'",
        "SBB_FRONTEND_REGISTRY?.competitionMap?.()"
      ]
    },
    "sbb/day_state.py": {
      "required": [
        "COLD_WARMING",
        "STALE_REFRESHING",
        "\"engineVersion\":\"4.7.2\""
      ]
    },
    "architecture/day-state.js": {
      "required": [
        "Sports Big Board v4.7.2",
        "version:'4.7.2'"
      ]
    },
    "architecture/competition-registry-projection.js": {
      "required": [
        "Sports Big Board v4.7.2",
        "specialRenderKey",
        "leagueRenderKey",
        "recursive MutationObserver/render loop",
        "setInterval(ensureDevCard,1500)",
        "without watching unrelated DOM mutations"
      ],
      "forbidden": [
        "new MutationObserver",
        ".observe(document.documentElement"
      ]
    },
    "foundation-certification.json": {
      "required": [
        "\"release\": \"4.7.2\"",
        "document-wide MutationObserver",
        "launchPlayBtn remain responsive",
        "idempotent"
      ]
    },
    "tests/test_v471_day_state_registry_resilience.py": {
      "required": [
        "self.assertTrue(VERSION.startswith(\"4.7.\"))",
        "f\"architecture/competition-registry-projection.js?v={VERSION}\""
      ]
    },
    "tests/test_v472_frontend_boot_responsiveness.py": {
      "required": [
        "test_frontend_registry_does_not_observe_entire_document",
        "test_registry_render_is_idempotent",
        "test_dev_card_uses_narrow_retry_without_dom_observer",
        "test_launch_screen_remains_static_before_start"
      ]
    },
    "VERIFY.sh": {
      "required": [
        "python3 tools/check_release_manifest.py",
        "python3 tools/check_release_version.py",
        "python3 -m unittest tests.test_v471_day_state_registry_resilience",
        "python3 -m unittest tests.test_v472_frontend_boot_responsiveness"
      ]
    }
  },
  "verification": [
    "python3 tools/check_release_manifest.py",
    "python3 tools/check_release_version.py",
    "python3 tools/check_foundation_certification.py",
    "python3 tools/check_ultimate_playback.py",
    "python3 tools/check_deploy_rehearsal.py",
    "python3 -m unittest tests.test_v471_day_state_registry_resilience",
    "python3 -m unittest tests.test_v472_frontend_boot_responsiveness",
    "bash VERIFY.sh"
  ]
}
