{
  "schemaVersion": 1,
  "release": "4.6.0",
  "baseRelease": "4.4.8",
  "title": "Competition Builder Foundation",
  "atomic": true,
  "requiredFiles": [
    "VERSION",
    "index.html",
    "core-model.js",
    "foundation-certification.json",
    "release-manifest.json",
    "architecture/competition-builder.js",
    "sbb/__init__.py",
    "sbb/competition_builder.py",
    "tests/test_v460_competition_builder.py"
  ],
  "contracts": {
    "VERSION": {
      "required": [
        "4.6.0"
      ]
    },
    "index.html": {
      "required": [
        "Sports Big Board \u2014 v4.6.0",
        "app.js?v=4.6.0",
        "architecture/competition-builder.js?v=4.6.0",
        "architecture/recap-identity-guard.js?v=4.6.0",
        "architecture/nfl-recap-reconciliation.js?v=4.6.0"
      ],
      "forbidden": [
        "?v=4.4.8",
        "?v=4.5."
      ]
    },
    "core-model.js": {
      "required": [
        "version:'4.6.0'",
        "custom-competition overlay",
        "window.SBB_COMPETITION_BUILDER"
      ]
    },
    "foundation-certification.json": {
      "required": [
        "\"release\": \"4.6.0\"",
        "Active special events appear in both Special Events and the main selector row"
      ]
    },
    "architecture/competition-builder.js": {
      "required": [
        "SPECIAL EVENTS \u25be",
        "ADD LEAGUE",
        "ADD SPECIAL EVENT",
        "2026 WORLD CUP TEMPLATE",
        "2026 LLWS TEMPLATE",
        "mainRowEligible",
        "SCORE_DATE_STORE?.setMatches",
        "gameCenterProviderHint:'competition-builder'",
        "SCORE_DATE_STORE?.setMedia",
        "/api/competition-builder/media"
      ]
    },
    "sbb/__init__.py": {
      "required": [
        "competition_builder",
        "_install_competition_builder"
      ]
    },
    "sbb/competition_builder.py": {
      "required": [
        "web_search",
        "custom-competitions.json",
        "generic_game_center",
        "_operator_media_playlist_normalize",
        "HISTORY_REPOSITORY.upsert_event",
        "AUTO_DISCOVER",
        "_generic_youtube_gap_search",
        "30*60",
        "/api/competition-builder/media"
      ]
    },
    "tests/test_v460_competition_builder.py": {
      "required": [
        "test_special_event_lifecycle_and_selector_placement",
        "test_schedule_normalizes_for_score_ribbon_and_game_center",
        "test_frontend_contracts_are_present"
      ]
    }
  },
  "verification": [
    "python3 tools/check_release_manifest.py",
    "python3 tools/check_release_version.py",
    "python3 tools/check_foundation_certification.py",
    "python3 tools/check_ultimate_playback.py",
    "python3 tools/check_deploy_rehearsal.py",
    "python3 -m unittest tests.test_v460_competition_builder",
    "bash VERIFY.sh"
  ]
}
