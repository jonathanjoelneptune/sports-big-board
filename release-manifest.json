{
  "schemaVersion": 1,
  "release": "4.7.2",
  "baseRelease": "4.7.1",
  "title": "Frontend Boot Responsiveness + Stable Verification Architecture",
  "atomic": true,
  "requiredFiles": [
    "VERIFY.sh",
    "VERSION",
    "index.html",
    "core-model.js",
    "foundation-certification.json",
    "release-manifest.json",
    "sbb/day_state.py",
    "architecture/day-state.js",
    "architecture/competition-registry-projection.js",
    "tests/test_release_behavior_gate.py"
  ],
  "contracts": {
    "VERSION": {
      "required": [
        "4.7.2"
      ]
    },
    "index.html": {
      "required": [
        "Sports Big Board \u2014 v4.7.2",
        "core-model.js?v=4.7.2",
        "app.js?v=4.7.2",
        "architecture/day-state.js?v=4.7.2",
        "architecture/competition-registry-projection.js?v=4.7.2",
        "id=\"launchPlayBtn\""
      ],
      "forbidden": [
        "?v=4.7.1"
      ]
    },
    "core-model.js": {
      "required": [
        "version:'4.7.2'",
        "SBB_FRONTEND_REGISTRY?.competitionMap?.()"
      ]
    },
    "sbb/day_state.py": {
      "required": [
        "COLD_WARMING",
        "STALE_REFRESHING",
        "\"engineVersion\":\"4.7.2\""
      ]
    },
    "architecture/day-state.js": {
      "required": [
        "Sports Big Board v4.7.2",
        "version:'4.7.2'"
      ]
    },
    "architecture/competition-registry-projection.js": {
      "required": [
        "Sports Big Board v4.7.2",
        "specialRenderKey",
        "leagueRenderKey",
        "recursive MutationObserver/render loop",
        "setInterval(ensureDevCard,1500)",
        "without watching unrelated DOM mutations"
      ],
      "forbidden": [
        "new MutationObserver",
        ".observe(document.documentElement"
      ]
    },
    "foundation-certification.json": {
      "required": [
        "\"release\": \"4.7.2\"",
        "document-wide MutationObserver",
        "launchPlayBtn remain responsive",
        "idempotent"
      ]
    },
    "VERIFY.sh": {
      "required": [
        "python3 tools/check_release_manifest.py",
        "python3 tools/check_release_version.py",
        "python3 tools/check_foundation_certification.py",
        "python3 tools/check_ultimate_playback.py",
        "python3 tools/check_deploy_rehearsal.py",
        "python3 -m unittest tests.test_release_behavior_gate",
        "[legacy-advisory]",
        "does not block deployment",
        "node tests/test_architecture.js",
        "python -m py_compile server.py sbb/*.py tests/*.py"
      ],
      "forbidden": [
        "python3 -m unittest tests.test_v471_day_state_registry_resilience",
        "python3 -m unittest tests.test_v472_frontend_boot_responsiveness"
      ]
    },
    "tests/test_release_behavior_gate.py": {
      "required": [
        "class ReleaseBehaviorGate",
        "test_launch_screen_has_interactive_start_control",
        "test_day_state_http_reads_do_not_build_on_request_thread",
        "test_dynamic_competitions_have_registry_builder_and_local_fallback",
        "test_legacy_archive_is_advisory_not_release_blocking"
      ],
      "forbidden": [
        "sbb-v471-restored",
        "sbb-v472-restored",
        "SELECT 1 FROM history_source_media"
      ]
    }
  },
  "verification": [
    "python3 tools/check_release_manifest.py",
    "python3 tools/check_release_version.py",
    "python3 tools/check_foundation_certification.py",
    "python3 tools/check_ultimate_playback.py",
    "python3 tools/check_deploy_rehearsal.py",
    "python3 -m unittest tests.test_release_behavior_gate",
    "bash VERIFY.sh"
  ]
}
