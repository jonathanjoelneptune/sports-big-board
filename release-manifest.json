      ],
      "forbidden": [
        "?v=4.7.11"
      ]
    },
    "architecture/native-transport.js": {
      "required": [
        "Sports Big Board v4.7.12",
        "capturedFetch",
        "window.SBB_API?.url",
        "window.SBB_NATIVE_TRANSPORT"
      ]
    },
    "architecture/score-date-store.js": {
      "required": [
        "Sports Big Board v4.7.12 ScoreDateStore",
        "version:'1.0'",
        "do not clamp future scheduled dates to today"
      ],
      "forbidden": [
        "version:'1.1"
      ]
    },
    "architecture/score-card-availability-index.js": {
      "required": [
        "Sports Big Board v4.7.12",
        "canonical Day State eventPlans",
        "catalogPlanForScoreGame",
        "payload?.eventPlans",
        "plan?.playable",
        "kind:'day-state-plan'",
        "kind:'scheduled'",
        "kind:'thin-score-only'",
        "legacy-resolved",
        "originalPlayable(match)"
      ]
    },
    "architecture/render-pipeline.js": {
      "required": [
        "Sports Big Board v4.7.12",
        "perfStartedAt",
        "perfFinishedAt",
        "availabilityPlanCount",
        "availabilityPlanPlayable",
        "availabilitySessionVerified"
      ]
    },
    "architecture/efficiency-certification.js": {
      "required": [
        "Sports Big Board v4.7.12",
        "window.SBB_NATIVE_TRANSPORT?.fetch",
        "window.SBB_NATIVE_TRANSPORT?.url?.(path)",
        "function attributeLongTask",
        "'LONGEST TASKS'",
        "AVAIL_PLANS=",
        "AVAIL_PLAN_PLAYABLE=",
        "AVAIL_SESSION_VERIFIED=",
        "THIN_TRANSPORT="
      ]
    },
    "tests/test_v4711_availability_index_thin_probe_runtime.js": {
      "required": [
        "parts[2]>=11",
        "retains v4.7.11"
      ],
      "forbidden": [
        "assert.strictEqual(VERSION,'4.7.11')"
      ]
    },
    "tests/test_v4712_day_state_render_model_runtime.js": {
      "required": [
        "native thin transport + Day State render model + long-task attribution contracts",
        "originalCalls,1",
        "stats.planPlayable>=1",
        "stats.fallbacks,1"
      ]
    },
    "tests/test_v4712_day_state_render_model.py": {
      "required": [
        "test_native_transport_precedes_request_broker",
        "test_thin_probe_uses_native_api_aware_transport",
        "test_day_state_event_plans_are_primary_media_fast_path",
        "test_long_tasks_are_correlated_to_render_intervals"
      ]
    },
    "tests/test_release_behavior_gate.py": {
      "required": [
        "test_native_certification_transport_is_captured_before_request_broker",
        "test_day_state_event_plans_drive_known_score_card_media",
        "test_long_task_attribution_links_main_thread_to_render_context",
        "node tests/test_v4712_day_state_render_model_runtime.js",
        "python3 -m unittest tests.test_v4712_day_state_render_model"
      ]
    },
    "foundation-certification.json": {
      "required": [
        "\"release\": \"4.7.12\"",
        "Native Transport Snapshot captures the browser fetch",
        "canonical Day State eventPlans",
        "five longest tasks",
        "ScoreDateStore public module API remains exactly version 1.0"
      ]
    },
    "VERIFY.sh": {
      "required": [
        "node tests/test_v4711_availability_index_thin_probe_runtime.js",
        "node tests/test_v4712_day_state_render_model_runtime.js",
        "python3 -m unittest tests.test_v4712_day_state_render_model",
        "[legacy-advisory]"
      ]
    }
  },
  "verification": [
