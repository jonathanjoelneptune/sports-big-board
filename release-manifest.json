{
  "schemaVersion": 1,
  "release": "4.5.1",
  "baseRelease": "4.5.0",
  "title": "Media Intelligence Startup Stability Hotfix",
  "atomic": true,
  "requiredFiles": [
    "VERSION",
    "index.html",
    "core-model.js",
    "foundation-certification.json",
    "release-manifest.json",
    "VERIFY.sh",
    "architecture/media-intelligence.js",
    "tests/test_v450_media_intelligence_runtime.js",
    "tests/test_v451_startup_stability_runtime.js",
    "tools/check_release_manifest.py",
    "tools/check_deploy_rehearsal.py"
  ],
  "contracts": {
    "VERSION": {"required": ["4.5.1"]},
    "index.html": {
      "required": [
        "Sports Big Board — v4.5.1",
        "architecture/media-intelligence.js?v=4.5.1",
        "architecture/site-soundtrack.js?v=4.5.1",
        "app.js?v=4.5.1"
      ],
      "forbidden": ["?v=4.5.0"]
    },
    "core-model.js": {"required": ["version:'4.5.1'"]},
    "foundation-certification.json": {"required": ["\"release\": \"4.5.1\"", "Media Intelligence"]},
    "architecture/media-intelligence.js": {
      "required": [
        "scheduleAudibleTruth",
        "reported===wanted||audibleWritePending===wanted",
        "queueMicrotask",
        "no global src MutationObserver",
        "installNativeGuards",
        "preloadBlocks",
        "abortMatchingResources",
        "version:'1.1'"
      ],
      "forbidden": ["new MutationObserver("]
    },
    "VERIFY.sh": {
      "required": [
        "python3 tools/check_release_manifest.py",
        "node tests/test_v450_media_intelligence_runtime.js",
        "node tests/test_v451_startup_stability_runtime.js"
      ]
    },
    "tests/test_v451_startup_stability_runtime.js": {
      "required": [
        "startup feedback-loop and DOM-churn guards",
        "new MutationObserver("
      ]
    },
    "tools/check_release_manifest.py": {
      "required": [
        "CHANGED-FILES-vX.X.X.txt files are intentionally ignored",
        "release manifest may not require bookkeeping file"
      ],
      "forbidden": [
        "changed=f'CHANGED-FILES-v{release}.txt'"
      ]
    },
    "tools/check_deploy_rehearsal.py": {
      "required": [
        "CHANGED-FILES-vX.X.X.txt bookkeeping is never read",
        "CHANGED-FILES ignored"
      ],
      "forbidden": [
        "overlay_manifest_check",
        "CHANGED-FILES-v{VERSION}.txt"
      ]
    }
  },
  "verification": [
    "python3 tools/check_release_manifest.py",
    "python3 tools/check_release_version.py",
    "python3 tools/check_foundation_certification.py",
    "python3 tools/check_ultimate_playback.py",
    "python3 tools/check_deploy_rehearsal.py",
    "node tests/test_v450_media_intelligence_runtime.js",
    "node tests/test_v451_startup_stability_runtime.js",
    "bash VERIFY.sh"
  ]
}
